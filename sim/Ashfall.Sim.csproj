<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Engine-free simulation core. Nothing in here may reference Godot:
    the game project only renders this state and feeds it input.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Ashfall.Sim</RootNamespace>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ashfall.Sim.Tests" />
  </ItemGroup>

</Project>
